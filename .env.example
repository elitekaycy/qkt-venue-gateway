# Copy to .env (never committed). Tokens are what qkt and guardrails send as bearer tokens.

PAPER_TRADER_TOKEN=change-me
PAPER_GUARDIAN_TOKEN=change-me-too
# PAPER_STARTING_BALANCE=10000

# Only for `docker compose --profile deribit up`. An API key with read and trade scopes, never withdrawal.
DERIBIT_TRADER_TOKEN=
DERIBIT_GUARDIAN_TOKEN=
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
DERIBIT_ENVIRONMENT=testnet
